#include "post_fusion_trial.h"
#if defined(BO1_NATIVE_POST_FUSION_TRIAL) && BO1_NATIVE_POST_FUSION_TRIAL
#include "post_fusion_trial_bytecode.h"
#include "gfx_d3d/rb_backend.h"
#include "gfx_d3d/rb_postfx.h"
#include "gfx_d3d/r_foliage.h"
#include "database/db_material_graph_types.h"
#include "database/db_techset_types.h"
#include "universal/dvar.h"
#include <algorithm>
#include <array>
#include <cmath>
#include <climits>
#include <cstdio>
#include <cstdlib>
#include <cstring>

namespace bo1::android::post_fusion_trial {
namespace {
template<class T> class Ref {
public:
    T* p{};
    Ref() = default;
    ~Ref() { reset(); }
    Ref(const Ref&) = delete;
    Ref& operator=(const Ref&) = delete;
    void reset() { if (p) p->Release(); p = nullptr; }
    T** put() { reset(); return &p; }
};
const dvar_s* control{};
[[noreturn]] void Fatal(const char* operation, HRESULT hr) {
    std::fprintf(stderr, "BO1_NATIVE_BLOOM_FUSION restore_failure=%s hr=0x%08x\n", operation, static_cast<unsigned>(hr));
    std::fflush(stderr); std::abort();
}
void RestoreCheck(const char* operation, HRESULT hr) { if (hr != S_OK) Fatal(operation, hr); }
bool Unorm(D3DFORMAT f) { return f == D3DFMT_A8R8G8B8 || f == D3DFMT_A8B8G8R8; }
constexpr D3DSAMPLERSTATETYPE SamplerTypes[] = {
    D3DSAMP_ADDRESSU,D3DSAMP_ADDRESSV,D3DSAMP_ADDRESSW,D3DSAMP_BORDERCOLOR,
    D3DSAMP_MAGFILTER,D3DSAMP_MINFILTER,D3DSAMP_MIPFILTER,D3DSAMP_MIPMAPLODBIAS,
    D3DSAMP_MAXMIPLEVEL,D3DSAMP_MAXANISOTROPY,D3DSAMP_SRGBTEXTURE,D3DSAMP_ELEMENTINDEX,D3DSAMP_DMAPOFFSET};
struct Snapshot {
    D3DVIEWPORT9 viewport{};
    RECT scissor{};
    DWORD scissorEnabled{};
    float matrix[16]{}, constants[24*4]{};
    DWORD sampler[2][std::size(SamplerTypes)]{};
    bool valid{};
};
struct Owner {
    IDirect3DDevice9* device{}; // Borrowed until root's pre-reset/pre-release hook.
    Ref<IDirect3DPixelShader9> shader;
    Ref<IDirect3DVertexShader9> vertex;
    Ref<IDirect3DVertexDeclaration9> declaration;
    Ref<IDirect3DTexture9> inputs[2];
    Ref<IDirect3DTexture9> sourceInputs[2];
    Ref<IDirect3DSurface9> inputSurfaces[2];
    Ref<IDirect3DSurface9> original, test, originalRead, testRead;
    Snapshot bloom{}, color{};
    Material material{};
    MaterialTechniqueSet techniques{};
    MaterialTechnique technique{};
    MaterialPixelShader pixel{};
    MaterialShaderArgument args[17]{};
    float film[3][4]{}, approvedFilm[3][4]{}, approvedColor[11][4]{};
    unsigned width{}, height{};
    D3DFORMAT format{};
    const GfxImage* sourceImages[2]{};
    unsigned char codeSamplers[3]{};
    unsigned pairs{};
    bool allPairs{true};
    bool attempted{}, active{}, accepted{}, drawing{};
    unsigned fusedAllowed{}, fusedSeen{};
    const GfxViewInfo* view{};
} owner;
void DropTemporary() {
    for (unsigned i=0;i<2;++i) { owner.inputSurfaces[i].reset(); owner.inputs[i].reset(); }
    owner.original.reset(); owner.test.reset(); owner.originalRead.reset(); owner.testRead.reset();
    owner.active = false; owner.view = nullptr;
}
void Incomplete(const char* reason) {
    std::fprintf(stderr,"BO1_NATIVE_BLOOM_FUSION validation=incomplete reason=%s\n",reason);
    owner.allPairs=false; owner.accepted=false; DropTemporary();
}
template<class T, std::size_t N> bool Program(T* shader, const std::uint32_t (&expected)[N]) {
    if (!shader) return false;
    UINT bytes{};
    if (shader->GetFunction(nullptr,&bytes)!=S_OK || bytes!=sizeof(expected)) return false;
    std::array<std::uint32_t,N> actual{};
    return shader->GetFunction(actual.data(),&bytes)==S_OK && bytes==sizeof(expected)
        && std::memcmp(actual.data(),expected,sizeof(expected))==0;
}
const MaterialPass* Pass(const Material* m, const char* name, unsigned count) {
    if (!m || !m->info.name || std::strcmp(m->info.name,name) || !m->techniqueSet
        || m->textureCount || m->constantCount || m->stateBitsCount!=1 || !m->stateBitsTable
        || m->stateBitsEntry[4]!=0 || m->stateBitsTable[0].loadBits[0]!=0x18128812u
        || m->stateBitsTable[0].loadBits[1]!=0xe00e0002u) return nullptr;
    auto* t=m->techniqueSet->techniques[4];
    if (!t || t->passCount!=1) return nullptr;
    const auto* p=&t->passArray[0];
    if (!p->args || !p->pixelShader || !p->vertexShader || p->customSamplerFlags
        || p->perPrimArgCount!=1 || p->perObjArgCount || p->stableArgCount!=count-1) return nullptr;
    if (p->args[0].type!=3 || p->args[0].dest!=0 || p->args[0].u.codeConst.index!=219
        || p->args[0].u.codeConst.firstRow || p->args[0].u.codeConst.rowCount!=4) return nullptr;
    return p;
}
bool Metadata() {
    const auto* b=Pass(rgp.bloomApplyLDR,"bloom_apply_ldr",6);
    const auto* c=Pass(rgp.postFxColorMaterial,"postfx_color",13);
    if (!b || !c || !Program(b->pixelShader->prog.ps,bytecode::BloomPS)
        || !Program(c->pixelShader->prog.ps,bytecode::ColorPS)
        || !Program(b->vertexShader->prog.vs,bytecode::SharedVS)
        || !Program(c->vertexShader->prog.vs,bytecode::SharedVS)) return false;
    for (unsigned i=0;i<2;++i)
        if (b->args[i+1].type!=4 || b->args[i+1].dest!=i || b->args[i+1].u.codeSampler!=35-i) return false;
    for (unsigned i=0;i<3;++i)
        if (b->args[i+3].type!=5 || b->args[i+3].dest!=5+i || b->args[i+3].u.codeConst.index!=121+i
            || b->args[i+3].u.codeConst.firstRow || b->args[i+3].u.codeConst.rowCount!=1) return false;
    if (c->args[1].type!=4 || c->args[1].dest || c->args[1].u.codeSampler!=10) return false;
    for (unsigned i=0;i<11;++i) {
        const auto& a=c->args[i+2];
        if (a.type!=5 || a.dest!=(i<7?5+i:20+i-7) || a.u.codeConst.index!=121+i
            || a.u.codeConst.firstRow || a.u.codeConst.rowCount!=1) return false;
    }
    return true;
}
bool View(const GfxViewInfo* v) {
    if (!v || !v->isRenderingFullScreen || !RB_UsingPostEffects(v) || gfxCmdBufState.stateOverride!=0) return false;
    const auto& viewport=v->cullViewInfo.displayViewport;
    const auto& target=gfxRenderTargets[R_RENDERTARGET_SCENE];
    return viewport.x==0 && viewport.y==0 && viewport.width==static_cast<int>(target.width)
        && viewport.height==static_cast<int>(target.height) && target.width && target.height
        && gfxCmdBufState.renderTargetId==R_RENDERTARGET_SCENE;
}
bool SnapshotPass(IDirect3DDevice9* d, Snapshot& s, bool bloom, bool fused=false) {
    s={};
    constexpr D3DRENDERSTATETYPE states[]={D3DRS_ALPHABLENDENABLE,D3DRS_ALPHATESTENABLE,D3DRS_ZENABLE,
        D3DRS_ZWRITEENABLE,D3DRS_STENCILENABLE,D3DRS_SRGBWRITEENABLE};
    for (auto state:states) { DWORD value{}; if (d->GetRenderState(state,&value)!=S_OK || value) return false; }
    DWORD mask{}; if (d->GetRenderState(D3DRS_COLORWRITEENABLE,&mask)!=S_OK || mask!=15) return false;
    if (d->GetViewport(&s.viewport)!=S_OK || s.viewport.X || s.viewport.Y
        || s.viewport.Width!=owner.width || s.viewport.Height!=owner.height
        || s.viewport.MinZ!=0 || s.viewport.MaxZ!=1) return false;
    if (d->GetRenderState(D3DRS_SCISSORTESTENABLE,&s.scissorEnabled)!=S_OK || d->GetScissorRect(&s.scissor)!=S_OK) return false;
    if (s.scissorEnabled && (s.scissor.left || s.scissor.top || s.scissor.right!=static_cast<LONG>(owner.width)
        || s.scissor.bottom!=static_cast<LONG>(owner.height))) return false;
    if (d->GetVertexShaderConstantF(0,s.matrix,4)!=S_OK || d->GetPixelShaderConstantF(0,s.constants,24)!=S_OK) return false;
    for (float value:s.matrix) if (!std::isfinite(value)) return false;
    const float iw=static_cast<float>(1.0/static_cast<double>(owner.width));
    const float ih=static_cast<float>(1.0/static_cast<double>(owner.height));
    const float expected[16]={iw*2,0,0,-1-iw,0,ih*-2,0,1+ih,0,0,0,1,0,0,0,1};
    if (std::memcmp(s.matrix,expected,sizeof(expected))) return false;
    if (bloom && !fused) {
        for (unsigned i=20;i<32;++i) if (!std::isfinite(s.constants[i])) return false;
    } else {
        for (unsigned i=20;i<48;++i) if (!std::isfinite(s.constants[i])) return false;
        for (unsigned i=80;i<96;++i) if (!std::isfinite(s.constants[i])) return false;
    }
    for (unsigned i=0;i<(bloom?2u:1u);++i) {
        for (unsigned k=0;k<std::size(SamplerTypes);++k)
            if (d->GetSamplerState(i,SamplerTypes[k],&s.sampler[i][k])!=S_OK) return false;
        if (s.sampler[i][10] || s.sampler[i][7] || s.sampler[i][8] || s.sampler[i][6]!=D3DTEXF_NONE
            || (s.sampler[i][4]!=D3DTEXF_POINT && s.sampler[i][4]!=D3DTEXF_LINEAR)
            || (s.sampler[i][5]!=D3DTEXF_POINT && s.sampler[i][5]!=D3DTEXF_LINEAR)) return false;
        Ref<IDirect3DBaseTexture9> texture; Ref<IDirect3DTexture9> actual;
        if (d->GetTexture(i,texture.put())!=S_OK || !texture.p
            || texture.p->QueryInterface(__uuidof(IDirect3DTexture9),reinterpret_cast<void**>(actual.put()))!=S_OK
            || actual.p!=owner.sourceInputs[bloom?i:1].p) return false;
    }
    Ref<IDirect3DPixelShader9> ps; Ref<IDirect3DVertexShader9> vs;
    if (d->GetPixelShader(ps.put())!=S_OK || d->GetVertexShader(vs.put())!=S_OK
        || !Program(vs.p,bytecode::SharedVS)) return false;
    if (fused ? !Program(ps.p,bytecode::FusedPS)
        : (bloom ? !Program(ps.p,bytecode::BloomPS) : !Program(ps.p,bytecode::ColorPS))) return false;
    s.valid=true; return true;
}
bool Texture(IDirect3DDevice9* d, const GfxImage* image, unsigned index) {
    if (!image || !image->texture.map) return false;
    Ref<IDirect3DTexture9> source;
    if (image->texture.map->QueryInterface(__uuidof(IDirect3DTexture9),reinterpret_cast<void**>(source.put()))!=S_OK) return false;
    D3DSURFACE_DESC desc{}; Ref<IDirect3DSurface9> surface;
    if (source.p->GetLevelDesc(0,&desc)!=S_OK || source.p->GetSurfaceLevel(0,surface.put())!=S_OK
        || desc.MultiSampleType!=D3DMULTISAMPLE_NONE || !desc.Width || !desc.Height) return false;
    owner.sourceInputs[index].reset(); owner.sourceInputs[index].p=source.p; source.p->AddRef();
    owner.sourceImages[index]=image;
    return d->CreateTexture(desc.Width,desc.Height,1,D3DUSAGE_RENDERTARGET,desc.Format,D3DPOOL_DEFAULT,
               owner.inputs[index].put(),nullptr)==S_OK
        && owner.inputs[index].p->GetSurfaceLevel(0,owner.inputSurfaces[index].put())==S_OK
        && d->StretchRect(surface.p,nullptr,owner.inputSurfaces[index].p,nullptr,D3DTEXF_NONE)==S_OK;
}
bool Resources(IDirect3DDevice9* d) {
    if (owner.device && owner.device!=d) return false;
    owner.device=d;
    if (!owner.shader.p && d->CreatePixelShader(bytecode::FusedPS,owner.shader.put())!=S_OK) return false;
    if (!owner.vertex.p && d->CreateVertexShader(bytecode::SharedVS,owner.vertex.put())!=S_OK) return false;
    const D3DVERTEXELEMENT9 elements[]={{0,0,D3DDECLTYPE_FLOAT3,D3DDECLMETHOD_DEFAULT,D3DDECLUSAGE_POSITION,0},
        {0,12,D3DDECLTYPE_FLOAT2,D3DDECLMETHOD_DEFAULT,D3DDECLUSAGE_TEXCOORD,0},D3DDECL_END()};
    return owner.declaration.p || d->CreateVertexDeclaration(elements,owner.declaration.put())==S_OK;
}
bool Prepare(const GfxViewInfo* v) {
    auto* d=gfxCmdBufState.prim.device;
    if (!d || !View(v) || !Metadata() || !Resources(d)) return false;
    Ref<IDirect3DSurface9> target;
    D3DSURFACE_DESC desc{};
    if (d->GetRenderTarget(0,target.put())!=S_OK || target.p->GetDesc(&desc)!=S_OK
        || !Unorm(desc.Format) || desc.MultiSampleType!=D3DMULTISAMPLE_NONE) return false;
    owner.width=desc.Width; owner.height=desc.Height; owner.format=desc.Format;
    if (desc.Width!=gfxRenderTargets[R_RENDERTARGET_SCENE].width || desc.Height!=gfxRenderTargets[R_RENDERTARGET_SCENE].height) return false;
    if (!Texture(d,gfxCmdBufSourceState.input.codeImages[35],0) || !Texture(d,gfxCmdBufSourceState.input.codeImages[34],1)) return false;
    if (gfxCmdBufSourceState.input.codeImageRenderTargetControl[35].packed
        || gfxCmdBufSourceState.input.codeImageRenderTargetControl[34].packed
        || gfxCmdBufSourceState.input.codeImageRenderTargetControl[10].packed) return false;
    if (owner.sourceInputs[1].p->GetLevelDesc(0,&desc)!=S_OK || !Unorm(desc.Format)
        || desc.Format!=owner.format || desc.Width!=owner.width || desc.Height!=owner.height) return false;
    owner.codeSamplers[0]=gfxCmdBufSourceState.input.codeImageSamplerStates[35];
    owner.codeSamplers[1]=gfxCmdBufSourceState.input.codeImageSamplerStates[34];
    owner.codeSamplers[2]=gfxCmdBufSourceState.input.codeImageSamplerStates[10];
    if (d->CreateRenderTarget(desc.Width,desc.Height,desc.Format,D3DMULTISAMPLE_NONE,0,FALSE,owner.original.put(),nullptr)!=S_OK
        || d->CreateRenderTarget(desc.Width,desc.Height,desc.Format,D3DMULTISAMPLE_NONE,0,FALSE,owner.test.put(),nullptr)!=S_OK
        || d->CreateOffscreenPlainSurface(desc.Width,desc.Height,desc.Format,D3DPOOL_SYSTEMMEM,owner.originalRead.put(),nullptr)!=S_OK
        || d->CreateOffscreenPlainSurface(desc.Width,desc.Height,desc.Format,D3DPOOL_SYSTEMMEM,owner.testRead.put(),nullptr)!=S_OK) return false;
    owner.bloom={}; owner.color={}; owner.view=v; owner.active=true; return true;
}
class StateScope {
    IDirect3DDevice9* d;
    Ref<IDirect3DStateBlock9> block;
    Ref<IDirect3DSurface9> targets[4], depth;
    unsigned count{};
    bool captured{};
public:
    explicit StateScope(IDirect3DDevice9* device):d(device) {
        D3DCAPS9 caps{};
        if (d->GetDeviceCaps(&caps)!=S_OK || caps.NumSimultaneousRTs>4 || !caps.NumSimultaneousRTs) return;
        count=caps.NumSimultaneousRTs;
        if (d->CreateStateBlock(D3DSBT_ALL,block.put())!=S_OK || block.p->Capture()!=S_OK) return;
        for (unsigned i=0;i<count;++i) {
            HRESULT hr=d->GetRenderTarget(i,targets[i].put());
            if (hr!=S_OK && hr!=D3DERR_NOTFOUND) return;
        }
        if (!targets[0].p) return;
        HRESULT hr=d->GetDepthStencilSurface(depth.put());
        if (hr!=S_OK && hr!=D3DERR_NOTFOUND) return;
        captured=true;
    }
    bool ready() const { return captured; }
    ~StateScope() {
        if (!captured) return;
        RestoreCheck("depth_null",d->SetDepthStencilSurface(nullptr));
        for (unsigned i=1;i<count;++i) RestoreCheck("mrt_null",d->SetRenderTarget(i,nullptr));
        RestoreCheck("target0",d->SetRenderTarget(0,targets[0].p));
        for (unsigned i=1;i<count;++i) RestoreCheck("mrt",d->SetRenderTarget(i,targets[i].p));
        RestoreCheck("depth",d->SetDepthStencilSurface(depth.p));
        RestoreCheck("stateblock",block.p->Apply());
    }
};
bool DrawTrial() {
    auto* d=owner.device;
    StateScope state(d);
    if (!state.ready()) return false;
    if (d->SetDepthStencilSurface(nullptr)!=S_OK) return false;
    D3DCAPS9 caps{}; if (d->GetDeviceCaps(&caps)!=S_OK) return false;
    for (unsigned i=1;i<caps.NumSimultaneousRTs;++i) if (d->SetRenderTarget(i,nullptr)!=S_OK) return false;
    if (d->SetRenderTarget(0,owner.test.p)!=S_OK || d->SetViewport(&owner.color.viewport)!=S_OK
        || d->SetVertexShader(owner.vertex.p)!=S_OK || d->SetVertexDeclaration(owner.declaration.p)!=S_OK
        || d->SetPixelShader(owner.shader.p)!=S_OK || d->SetVertexShaderConstantF(0,owner.color.matrix,4)!=S_OK
        || d->SetPixelShaderConstantF(5,&owner.color.constants[20],7)!=S_OK
        || d->SetPixelShaderConstantF(20,&owner.color.constants[80],4)!=S_OK
        || d->SetPixelShaderConstantF(64,&owner.bloom.constants[20],3)!=S_OK) return false;
    for (unsigned i=0;i<2;++i) {
        if (d->SetTexture(i,owner.inputs[i].p)!=S_OK) return false;
        for (unsigned k=0;k<std::size(SamplerTypes);++k)
            if (d->SetSamplerState(i,SamplerTypes[k],owner.bloom.sampler[i][k])!=S_OK) return false;
    }
    struct Vertex { float x,y,z,u,v; };
    const float w=static_cast<float>(owner.width),h=static_cast<float>(owner.height);
    const Vertex vertices[]={{0,0,0,0,0},{w,0,0,1,0},{w,h,0,1,1},{0,h,0,0,1}};
    const WORD indices[]={3,0,2,2,0,1};
    return d->DrawIndexedPrimitiveUP(D3DPT_TRIANGLELIST,0,4,2,indices,D3DFMT_INDEX16,vertices,sizeof(Vertex))==S_OK;
}
struct PixelDiff {
    std::uint64_t histogram[256]{},alphaMismatch{},pixelsDifferent{},channels{};
    unsigned maxRgb{};
};
bool ScanRGBA(unsigned width,unsigned height,const D3DLOCKED_RECT& a,const D3DLOCKED_RECT& b,PixelDiff& result) {
    if (!a.pBits || !b.pBits || width>static_cast<unsigned>(INT_MAX)/4
        || a.Pitch<static_cast<int>(width*4) || b.Pitch<static_cast<int>(width*4)) return false;
    for (unsigned y=0;y<height;++y) {
        const auto* left=static_cast<const unsigned char*>(a.pBits)+static_cast<std::size_t>(y)*a.Pitch;
        const auto* right=static_cast<const unsigned char*>(b.pBits)+static_cast<std::size_t>(y)*b.Pitch;
        for (unsigned x=0;x<width;++x) {
            bool changed=false;
            for (unsigned c=0;c<4;++c) {
                unsigned diff=static_cast<unsigned>(std::abs(static_cast<int>(left[x*4+c])-right[x*4+c]));
                changed|=diff!=0; ++result.histogram[diff]; ++result.channels;
                if (c==3) result.alphaMismatch+=diff!=0; else result.maxRgb=std::max(result.maxRgb,diff);
            }
            result.pixelsDifferent+=changed;
        }
    }
    return true;
}
bool Compare() {
    auto* d=owner.device;
    if (d->GetRenderTargetData(owner.original.p,owner.originalRead.p)!=S_OK
        || d->GetRenderTargetData(owner.test.p,owner.testRead.p)!=S_OK) return false;
    D3DLOCKED_RECT a{},b{};
    if (owner.originalRead.p->LockRect(&a,nullptr,D3DLOCK_READONLY)!=S_OK) return false;
    if (owner.testRead.p->LockRect(&b,nullptr,D3DLOCK_READONLY)!=S_OK) {
        RestoreCheck("unlock_original",owner.originalRead.p->UnlockRect()); return false;
    }
    PixelDiff result{}; const bool scanned=ScanRGBA(owner.width,owner.height,a,b,result);
    RestoreCheck("unlock_test",owner.testRead.p->UnlockRect());
    RestoreCheck("unlock_original",owner.originalRead.p->UnlockRect());
    if (!scanned) return false;
    const bool pairOk=!result.alphaMismatch && result.maxRgb<=1;
    owner.allPairs&=pairOk;
    ++owner.pairs;
    if (owner.pairs>1 && (std::memcmp(owner.approvedFilm,&owner.bloom.constants[20],sizeof(owner.approvedFilm))
        || std::memcmp(owner.approvedColor,&owner.color.constants[20],7*16)
        || std::memcmp(owner.approvedColor[7],&owner.color.constants[80],4*16))) owner.allPairs=false;
    owner.accepted=owner.pairs==3 && owner.allPairs;
    std::fprintf(stderr,"BO1_NATIVE_BLOOM_FUSION validation=%s pair=%u/3 pair_ok=%d pixels=%llu different=%llu alpha_mismatch=%llu max_rgb=%u channels=%llu histogram=",
        !owner.allPairs?"rejected":(owner.pairs==3?"accepted":"pending"),owner.pairs,pairOk?1:0,static_cast<unsigned long long>(owner.width)*owner.height,
        static_cast<unsigned long long>(result.pixelsDifferent),static_cast<unsigned long long>(result.alphaMismatch),result.maxRgb,static_cast<unsigned long long>(result.channels));
    for (unsigned i=0;i<256;++i) if (result.histogram[i]) std::fprintf(stderr,"%u:%llu,",i,static_cast<unsigned long long>(result.histogram[i]));
    std::fprintf(stderr,"\n");
    if (owner.pairs==1) {
        std::memcpy(owner.approvedFilm,&owner.bloom.constants[20],sizeof(owner.approvedFilm));
        std::memcpy(owner.approvedColor,&owner.color.constants[20],7*16);
        std::memcpy(owner.approvedColor[7],&owner.color.constants[80],4*16);
    }
    return true;
}
void Clone() {
    const auto* b=Pass(rgp.bloomApplyLDR,"bloom_apply_ldr",6);
    const auto* c=Pass(rgp.postFxColorMaterial,"postfx_color",13);
    owner.material=*rgp.bloomApplyLDR; owner.material.info.name="native_bloom_color_trial";
    owner.techniques=*rgp.bloomApplyLDR->techniqueSet;
    owner.technique=*rgp.bloomApplyLDR->techniqueSet->techniques[4];
    owner.pixel={}; owner.pixel.name="native_bloom_color_unorm8_trial";
    owner.pixel.prog.ps=owner.shader.p;
    owner.pixel.prog.loadDef.program=const_cast<DWORD*>(bytecode::FusedPS);
    owner.pixel.prog.loadDef.programSize=sizeof(bytecode::FusedPS)/4;
    auto& p=owner.technique.passArray[0]; p=*b; p.pixelShader=&owner.pixel;
    owner.args[0]=b->args[0]; owner.args[1]=b->args[1]; owner.args[2]=b->args[2];
    for (unsigned i=0;i<11;++i) owner.args[i+3]=c->args[i+2];
    for (unsigned i=0;i<3;++i) {
        owner.args[i+14]={}; owner.args[i+14].type=7; owner.args[i+14].dest=64+i;
        owner.args[i+14].u.literalConst=owner.film[i];
    }
    p.args=owner.args; p.perPrimArgCount=1; p.perObjArgCount=0; p.stableArgCount=16;
    owner.techniques.techniques[4]=&owner.technique; owner.material.techniqueSet=&owner.techniques;
}
}
void RegisterControls() {
    control=_Dvar_RegisterInt("r_nativeBloomFusion",0,0,2,0,"Native bloom/color trial: 0 original, 1 three bounded paired comparisons, 2 validated fusion");
}
bool TryBloomColor(const GfxViewInfo* view) {
    if (!control || owner.drawing) return false;
    const int mode=control->current.integer;
    if (mode==0) { owner.attempted=false; if (owner.active) DropTemporary(); return false; }
    if (mode==1) {
        if (!owner.attempted) { owner.attempted=true; owner.accepted=false; owner.pairs=0; owner.allPairs=true; }
        if (!owner.active && owner.pairs<3 && owner.allPairs) {
            if (!Prepare(view)) Incomplete("prepare_gates_or_resources");
        }
        return false;
    }
    if (mode!=2 || !owner.accepted || !View(view) || !Metadata()
        || owner.device!=gfxCmdBufState.prim.device) return false;
    auto* device=owner.device;
    Ref<IDirect3DSurface9> target; D3DSURFACE_DESC desc{}; DWORD srgb{};
    if (device->GetRenderTarget(0,target.put())!=S_OK || target.p->GetDesc(&desc)!=S_OK
        || desc.Width!=owner.width || desc.Height!=owner.height || desc.Format!=owner.format
        || desc.MultiSampleType!=D3DMULTISAMPLE_NONE || device->GetRenderState(D3DRS_SRGBWRITEENABLE,&srgb)!=S_OK || srgb) return false;
    for (unsigned i=0;i<2;++i) {
        const unsigned code=35-i;
        if (gfxCmdBufSourceState.input.codeImages[code]!=owner.sourceImages[i]
            || gfxCmdBufSourceState.input.codeImageSamplerStates[code]!=owner.codeSamplers[i]) return false;
    }
    if (gfxCmdBufSourceState.input.codeImageSamplerStates[10]!=owner.codeSamplers[2]) return false;
    if (gfxCmdBufSourceState.input.codeImageRenderTargetControl[35].packed
        || gfxCmdBufSourceState.input.codeImageRenderTargetControl[34].packed
        || gfxCmdBufSourceState.input.codeImageRenderTargetControl[10].packed) return false;
    for (unsigned i=0;i<2;++i) {
        Ref<IDirect3DTexture9> source;
        if (!owner.sourceImages[i]->texture.map || owner.sourceImages[i]->texture.map->QueryInterface(__uuidof(IDirect3DTexture9),
                reinterpret_cast<void**>(source.put()))!=S_OK || source.p!=owner.sourceInputs[i].p) return false;
    }
    if (std::memcmp(&gfxCmdBufSourceState.input.consts[121],owner.approvedFilm,sizeof(owner.approvedFilm))) return false;
    float saved[11][4]; std::memcpy(saved,&gfxCmdBufSourceState.input.consts[121],sizeof(saved));
    RB_SetVisionSetColorCorrection(view);
    if (std::memcmp(&gfxCmdBufSourceState.input.consts[121],owner.approvedColor,sizeof(owner.approvedColor))) {
        for (unsigned i=0;i<11;++i) R_UpdateCodeConstantFromVec4(&gfxCmdBufSourceState,static_cast<CodeConstant>(121+i),saved[i]);
        return false;
    }
    std::memcpy(owner.film,saved,sizeof(owner.film)); Clone();
    owner.fusedAllowed=owner.fusedSeen=0;
    owner.drawing=true; RB_Filter(&owner.material,view); owner.drawing=false;
    if (owner.fusedAllowed==1 && owner.fusedSeen==1) return true;
    for (unsigned i=0;i<11;++i) R_UpdateCodeConstantFromVec4(&gfxCmdBufSourceState,static_cast<CodeConstant>(121+i),saved[i]);
    return false;
}
bool ObservePass(IDirect3DDevice9* device,const Material* material,unsigned passIndex) {
    if (owner.drawing && material==&owner.material) {
        ++owner.fusedSeen;
        Snapshot actual{}; float film[3][4]{};
        const bool allow=owner.fusedSeen==1 && !passIndex && device==owner.device
            && SnapshotPass(device,actual,true,true)
            && !std::memcmp(actual.matrix,owner.color.matrix,sizeof(actual.matrix))
            && !std::memcmp(actual.sampler,owner.bloom.sampler,sizeof(actual.sampler))
            && !std::memcmp(&actual.constants[20],owner.approvedColor,7*16)
            && !std::memcmp(&actual.constants[80],owner.approvedColor[7],4*16)
            && device->GetPixelShaderConstantF(64,&film[0][0],3)==S_OK
            && !std::memcmp(film,owner.approvedFilm,sizeof(film));
        if (allow) ++owner.fusedAllowed;
        return allow;
    }
    if (!owner.active || owner.drawing || passIndex || device!=owner.device) return true;
    if (material==rgp.bloomApplyLDR) {
        if (owner.bloom.valid || !SnapshotPass(device,owner.bloom,true)) Incomplete("bloom_boundary");
    } else if (material==rgp.postFxColorMaterial) {
        if (!owner.bloom.valid || owner.color.valid || !SnapshotPass(device,owner.color,false)) Incomplete("color_boundary");
    }
    return true;
}
void EndOriginalColor(const GfxViewInfo* view) {
    if (!owner.active) return;
    if (view!=owner.view || !owner.bloom.valid || !owner.color.valid
        || std::memcmp(owner.bloom.matrix,owner.color.matrix,sizeof(owner.bloom.matrix))) { Incomplete("paired_boundary_or_matrix"); return; }
    Ref<IDirect3DSurface9> actual; auto* d=owner.device;
    D3DSURFACE_DESC desc{};
    if (d->GetRenderTarget(0,actual.put())!=S_OK || actual.p->GetDesc(&desc)!=S_OK
        || desc.Width!=owner.width || desc.Height!=owner.height || desc.Format!=owner.format
        || desc.MultiSampleType!=D3DMULTISAMPLE_NONE
        || d->StretchRect(actual.p,nullptr,owner.original.p,nullptr,D3DTEXF_NONE)!=S_OK) { Incomplete("original_copy"); return; }
    if (!DrawTrial()) { Incomplete("offscreen_draw"); return; }
    if (!Compare()) { Incomplete("readback"); return; }
    DropTemporary();
}
void Release() {
    DropTemporary(); owner.shader.reset(); owner.vertex.reset(); owner.declaration.reset();
    owner.device=nullptr; owner.accepted=owner.attempted=owner.drawing=false;
    owner.sourceInputs[0].reset(); owner.sourceInputs[1].reset();
    owner.sourceImages[0]=owner.sourceImages[1]=nullptr;
    owner.bloom={}; owner.color={};
}
}
#else
namespace bo1::android::post_fusion_trial {
void RegisterControls() {}
bool TryBloomColor(const GfxViewInfo*) { return false; }
bool ObservePass(IDirect3DDevice9*,const Material*,unsigned) { return true; }
void EndOriginalColor(const GfxViewInfo*) {}
void Release() {}
}
#endif
