#include "performance_gpu_overlay.h"
#include "performance_overlay.h"
#include <d3d9.h>
#include <cstdint>
#include <mutex>
#include <time.h>
#include <cerrno>

namespace bo1::android::performance::gpu {
namespace {
constexpr unsigned SetCount = 8;
struct QuerySet {
    IDirect3DQuery9 *disjoint{}, *frequency{}, *begin{}, *end{};
    std::uint64_t sequence{}, stamp{};
    bool pending{}, eligible{};
};
struct Owner {
    std::mutex mutex;
    QuerySet sets[SetCount];
    IDirect3DDevice9 *device{}; // Non-owning; cleared before canonical device release.
    unsigned epoch{};
    std::uint64_t sequence{};
    int open{-1}, closed{-1};
    bool failed{};
};
Owner owner;
bool Clock(std::uint64_t &ns) {
    const int saved = errno;
    timespec value{};
    const bool ok = clock_gettime(CLOCK_MONOTONIC, &value) == 0 && value.tv_sec >= 0
        && value.tv_nsec >= 0 && value.tv_nsec < 1000000000;
    errno = saved;
    if (ok) ns = static_cast<std::uint64_t>(value.tv_sec) * 1000000000ULL + value.tv_nsec;
    return ok;
}
void Retire() {
    for (auto &set : owner.sets) {
        for (auto *query : {set.disjoint, set.frequency, set.begin, set.end})
            if (query) query->Release();
        set = {};
    }
    owner.device = nullptr; owner.open = owner.closed = -1;
    owner.sequence = 0; owner.failed = false;
}
void Fail(GpuStatus status) {
    const unsigned epoch = owner.epoch;
    Retire(); owner.failed = true;
    GpuObservation(epoch, status, -1, 0);
}
bool Initialize(IDirect3DDevice9 *device) {
    if (!device) { Fail(GpuStatus::Unavailable); return false; }
    // All four query types must exist. A partial initialization releases every
    // successfully created object and cannot publish a fabricated duration.
    owner.device = device;
    for (auto &set : owner.sets) {
        if (device->CreateQuery(D3DQUERYTYPE_TIMESTAMPDISJOINT, &set.disjoint) != S_OK
            || device->CreateQuery(D3DQUERYTYPE_TIMESTAMPFREQ, &set.frequency) != S_OK
            || device->CreateQuery(D3DQUERYTYPE_TIMESTAMP, &set.begin) != S_OK
            || device->CreateQuery(D3DQUERYTYPE_TIMESTAMP, &set.end) != S_OK) {
            Fail(GpuStatus::Unsupported); return false;
        }
    }
    return true;
}
void Poll() {
    // Fixed upper bound, in submission order; never reuse a still-pending set.
    for (unsigned count = 0; count < SetCount; ++count) {
        QuerySet *oldest = nullptr;
        for (auto &set : owner.sets)
            if (set.pending && set.eligible && (!oldest || set.sequence < oldest->sequence)) oldest = &set;
        if (!oldest) return;
        BOOL disjoint = TRUE;
        UINT64 frequency = 0, begin = 0, end = 0;
        const HRESULT results[4] = {
            oldest->disjoint->GetData(&disjoint, sizeof(disjoint), 0),
            oldest->frequency->GetData(&frequency, sizeof(frequency), 0),
            oldest->begin->GetData(&begin, sizeof(begin), 0),
            oldest->end->GetData(&end, sizeof(end), 0)
        };
        bool pending = false;
        for (const auto result : results) {
            if (result == S_FALSE) pending = true;
            else if (result != S_OK) { Fail(GpuStatus::Failed); return; }
        }
        if (pending) { GpuObservation(owner.epoch, GpuStatus::Pending, -1, 0); return; }
        oldest->pending = oldest->eligible = false;
        if (disjoint || !frequency || end < begin) {
            GpuObservation(owner.epoch, GpuStatus::Disjoint, -1, oldest->stamp);
        } else {
            const double ms = static_cast<double>(end - begin) * 1000.0 / static_cast<double>(frequency);
            GpuObservation(owner.epoch, GpuStatus::Valid, ms, oldest->stamp);
        }
    }
}
}
void Begin(IDirect3DDevice9 *device) {
    const unsigned epoch = Epoch();
    std::lock_guard<std::mutex> lock(owner.mutex);
    if (!epoch) { Retire(); owner.epoch = 0; return; }
    if (owner.epoch != epoch || (owner.device && owner.device != device)) {
        Retire(); owner.epoch = epoch;
    }
    if (owner.failed) return;
    if (!owner.device && !Initialize(device)) return;
    Poll();
    if (owner.failed || owner.open >= 0) return;
    for (unsigned i = 0; i < SetCount; ++i) {
        auto &set = owner.sets[i];
        if (set.pending) continue;
        if (set.disjoint->Issue(D3DISSUE_BEGIN) != S_OK || set.begin->Issue(D3DISSUE_END) != S_OK) {
            Fail(GpuStatus::Failed); return;
        }
        set.sequence = ++owner.sequence; set.stamp = 0; set.eligible = false;
        owner.open = static_cast<int>(i);
        GpuObservation(epoch, GpuStatus::Pending, -1, 0);
        return;
    }
    GpuObservation(epoch, GpuStatus::Pending, -1, 0);
}
void BeforePresent() {
    const unsigned epoch = Epoch();
    std::lock_guard<std::mutex> lock(owner.mutex);
    if (!epoch || epoch != owner.epoch) { Retire(); owner.epoch = epoch; return; }
    if (owner.open < 0 || owner.failed) return;
    auto &set = owner.sets[owner.open];
    if (set.end->Issue(D3DISSUE_END) != S_OK || set.frequency->Issue(D3DISSUE_END) != S_OK
        || set.disjoint->Issue(D3DISSUE_END) != S_OK || !Clock(set.stamp)) {
        Fail(GpuStatus::Failed); return;
    }
    set.pending = true;
    owner.closed = owner.open; owner.open = -1;
}
void Presented(bool active) {
    const unsigned epoch = Epoch();
    std::lock_guard<std::mutex> lock(owner.mutex);
    if (!active || !epoch || epoch != owner.epoch) {
        Retire(); owner.epoch = epoch;
        GpuObservation(epoch, GpuStatus::Unavailable, -1, 0);
        return;
    }
    if (owner.failed) return;
    if (owner.closed >= 0) {
        owner.sets[owner.closed].eligible = true; owner.closed = -1;
    }
    Poll();
}
void Release() {
    std::lock_guard<std::mutex> lock(owner.mutex);
    Retire(); owner.epoch = 0;
    GpuObservation(Epoch(), GpuStatus::Unavailable, -1, 0);
}
}
