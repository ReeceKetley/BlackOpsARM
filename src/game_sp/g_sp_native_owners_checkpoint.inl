// Private checkpoint codec. Decode validates owners but does not publish them:
// native FX pool reconstruction and audio cursor seeking must precede VM frames.
#include <EffectsCore/fx_system.h>
#include <EffectsCore/fx_archive.h>
#include <EffectsCore/fx_load_obj.h>
#include <sound/snd.h>
#include <sound/snd_bank.h>
#include <sound/snd_driver_api.h>
#include <sound/snd_public_async.h>
#include <sound/snd_public_async_q.h>
#include <sound/snd_local.h>
#include <sound/snd_occlusion.h>
#include <qcommon/threads.h>
#include <limits>
#include <type_traits>
#include <EffectsCore/fx_unique_handle.h>

struct SPFxCheckpointControls
{
    FxCamera cameras[4];
    unsigned restartList[32];
    FxPriorityInfo priority;
    bool needsCollection, staleAttachments;
    short spotlightBolt;
    unsigned short spotlightEffect, spotlightElement;
    unsigned spotlightEffects, spotlightElements;
};

struct SPFxCheckpointStage
{
    FxSystemContainer container;
    FxSystemBuffers buffers;
    int effects, particles, trails, trailElements, physicalParticles;
    SPFxCheckpointControls controls;
    bool hasControls;
    struct PhysicalOwner
    {
        bool present;
        unsigned short effectHandle;
        PhysSavedBodyState body;
    } physical[FX_ELEM_POOL_MAX];
};

struct SPNativeCheckpointCodec
{
    MemoryFile *reader, *writer;
    void Field(bool &value)
    {
        unsigned char encoded = 0;
        if (reader) MemFile_ReadData(reader, 1, &encoded);
        else memcpy(&encoded, &value, 1);
        if (encoded > 1) Com_Error(ERR_DROP, "Native checkpoint rejected boolean %u", encoded);
        if (reader) value = encoded != 0;
        MemFile_WriteData(writer, 1, &encoded);
    }
    template<class T> void Field(T &value)
    {
        static_assert(std::is_trivially_copyable_v<T> && !std::is_pointer_v<T>);
        if (reader) MemFile_ReadData(reader, sizeof(value), reinterpret_cast<unsigned char *>(&value));
        MemFile_WriteData(writer, sizeof(value), reinterpret_cast<unsigned char *>(&value));
    }
    int Int(int value)
    {
        Field(value); return value;
    }
    const char *Name(const char *value)
    {
        if (reader) value = MemFile_ReadCString(reader);
        if (!value || !*value || strlen(value) > 255)
            Com_Error(ERR_DROP, "Native checkpoint rejected asset identity");
        MemFile_WriteCString(writer, const_cast<char *>(value)); return value;
    }
};

static bool SP_QuiesceClientAudioCheckpoint()
{
    if (!SND_Active()) return false;
    // Notifications own playback pointers and can issue new commands. Deliver
    // them while the old VM/world is live, before either VM is serialized.
    SND_UpdateWait();
    for (int pass = 0; pass < 8; ++pass)
    {
        SND_NotifyPump();
        if (!SND_CommandPeek() && !SND_NotifyPeek()) return true;
        if (!SND_GetProcessCommandFlag()) return false;
        // Pump only the commands generated by notification delivery. Running a
        // new sound frame here would generate fresh entity-update notifications
        // on every pass and could never reach a joined boundary.
        SND_CommandPump();
    }
    Com_Printf(15, "Client checkpoint: sound command/notification boundary is still busy\n");
    return false;
}

static bool SP_FreezeAudioCheckpoint()
{
    if (SND_OcclusionCheckpointActive() || !SD_BeginCheckpoint()) return false;
    if (SND_BeginOcclusionCheckpoint()) return true;
    // A rejected/expired worker gate must not strand the already stopped
    // device. No gate was acquired, so longjmp cleanup cannot release it.
    SD_EndCheckpoint();
    return false;
}

static int SP_NativeHandleIndex(unsigned handle, int count, unsigned stride)
{
    if (handle == 0xFFFF) return -1;
    if (handle % stride || handle / stride >= static_cast<unsigned>(count))
        Com_Error(ERR_DROP, "Native checkpoint rejected pool handle");
    return handle / stride;
}

static void SP_ClientEffectsCodec(SPNativeCheckpointCodec &c, SPFxCheckpointStage *stage = nullptr,
    const SPFxCheckpointStage *verifyPhysics = nullptr)
{
    if (stage) memset(stage->physical, 0, sizeof(stage->physical));
    const int schema = c.Int(0x32505846); // FXP2; the earlier decode-only FXP1 remains readable
    if (schema != 0x31505846 && schema != 0x32505846)
        Com_Error(ERR_DROP, "Client effects checkpoint schema mismatch");
    FxSystem *system = &FX_GetSystem(0)->system;
    if (!c.reader && (!system->isInitialized || system->shared->iteratorCount))
        Com_Error(ERR_DROP, "Client effects checkpoint requires joined FX owners");
    const int effectStride = sizeof(FxEffectContainer) / 4;
    if (c.Int(effectStride) != effectStride || c.Int(fx_elemLimit) != fx_elemLimit)
        Com_Error(ERR_DROP, "Client effects checkpoint pool ABI mismatch");
    const int msecNow = c.Int(system->msecNow), msecDraw = c.Int(system->msecDraw), frameCount = c.Int(system->frameCount);
    if (stage)
    {
        stage->container.system.msecNow = msecNow;
        stage->container.system.msecDraw = msecDraw;
        stage->container.system.frameCount = frameCount;
    }
    unsigned first = system->shared->firstActiveEffect, next = system->shared->firstNewEffect, last = system->shared->firstFreeEffect;
    c.Field(first); c.Field(next); c.Field(last);
    if (last - first > 1024 || next - first > last - first)
        Com_Error(ERR_DROP, "Client effects checkpoint rejected effect ring");
    unsigned short ring[1024]{};
    if (!c.reader) memcpy(ring, system->shared->allEffectHandles, sizeof(ring));
    c.Field(ring);
    bool ringSeen[1024]{};
    for (unsigned short handle : ring)
    {
        const int index = SP_NativeHandleIndex(handle, 1024, effectStride);
        if (index < 0 || ringSeen[index]) Com_Error(ERR_DROP, "Client effects checkpoint rejected ring alias");
        ringSeen[index] = true;
    }
    int freeNode = system->uniqueHandleDb->firstFreeNode, used = system->uniqueHandleDb->numNodesInUse;
    c.Field(freeNode); c.Field(used);
    if (freeNode < -1 || freeNode >= 1024 || used < 0 || used > 1024)
        Com_Error(ERR_DROP, "Client effects checkpoint rejected handle allocator");
    int links[1024]{}; unsigned handles[1024]{}; unsigned short owners[1024]{};
    int live = 0;
    bool uniqueOwners[1024]{};
    for (int i = 0; i < 1024; ++i)
    {
        if (!c.reader)
        {
            links[i] = system->uniqueHandleDb->nodes[i].nextNode;
            handles[i] = system->uniqueHandleDb->nodes[i].handle;
            owners[i] = system->uniqueHandleDb->nodes[i].effect;
        }
        c.Field(links[i]); c.Field(handles[i]); c.Field(owners[i]);
        if (handles[i] >> 16 != static_cast<unsigned>(i + 1) || links[i] < -1 || links[i] >= 1024)
            Com_Error(ERR_DROP, "Client effects checkpoint rejected handle generation/node");
        if (owners[i] != 0xFFFF)
        {
            const int index = SP_NativeHandleIndex(owners[i], 1024, effectStride);
            if (links[i] != -1 || uniqueOwners[index]) Com_Error(ERR_DROP, "Client effects checkpoint rejected duplicate handle owner");
            uniqueOwners[index] = true; ++live;
        }
    }
    bool freeSeen[1024]{}; int freeCount = 0;
    for (int i = freeNode; i != -1; i = links[i])
    {
        if (freeSeen[i] || owners[i] != 0xFFFF) Com_Error(ERR_DROP, "Client effects checkpoint rejected free handle chain");
        freeSeen[i] = true; ++freeCount;
    }
    if (used != live || live + freeCount != 1024)
        Com_Error(ERR_DROP, "Client effects checkpoint rejected handle accounting");
    if (stage)
    {
        stage->container.shared.firstActiveEffect = first;
        stage->container.shared.firstNewEffect = next;
        stage->container.shared.firstFreeEffect = last;
        memcpy(stage->container.shared.allEffectHandles, ring, sizeof(ring));
        auto &db = stage->buffers.uniqueHandleDb;
        db.firstFreeNode = freeNode; db.numNodesInUse = used;
        for (int i = 0; i < 1024; ++i)
        {
            db.nodes[i].nextNode = links[i]; db.nodes[i].handle = handles[i]; db.nodes[i].effect = owners[i];
        }
    }
    bool elemsSeen[FX_ELEM_POOL_MAX]{}, trailsSeen[128]{}, trailElemsSeen[2048]{};
    int elems = 0, trails = 0, trailElems = 0, physics = 0;
    for (unsigned n = first; n != last; ++n)
    {
        const unsigned short handle = ring[n & 1023];
        FxEffect effect{}; unsigned status = 0;
        if (!c.reader) { const auto *owner = FX_EffectFromHandle(system, handle); effect = owner->effect; status = owner->atomics.status; }
        if (!c.reader && !effect.def) Com_Error(ERR_DROP, "Client effects checkpoint missing definition owner");
        const char *name = c.Name(c.reader ? nullptr : effect.def->name);
        const FxEffectDef *def = c.reader ? FX_Register(name) : effect.def;
        if (!def || I_stricmp(def->name, name)) Com_Error(ERR_DROP, "Client effects checkpoint missing exact definition");
        c.Field(status);
        // Every field after def is logical. Encode fields individually, excluding padding.
#define FX_FIELD(member) c.Field(effect.member)
        FX_FIELD(firstElemHandle); FX_FIELD(firstSortedElemHandle); FX_FIELD(firstTrailHandle);
        FX_FIELD(randomSeed); FX_FIELD(owner); FX_FIELD(lightR); FX_FIELD(lightG); FX_FIELD(lightB);
        FX_FIELD(boltAndSortOrder); unsigned frame = effect.frameCount; c.Field(frame);
        FX_FIELD(msecBegin); FX_FIELD(msecLastUpdate); FX_FIELD(frameAtSpawn); FX_FIELD(frameNow); FX_FIELD(framePrev);
        FX_FIELD(distanceTraveled); FX_FIELD(boneOffset); FX_FIELD(uniqueHandle);
#undef FX_FIELD
        const unsigned node = (effect.uniqueHandle >> 16) - 1;
        if (node >= 1024 || handles[node] != effect.uniqueHandle || owners[node] != handle)
            Com_Error(ERR_DROP, "Client effects checkpoint lost script handle ownership");
        if (stage)
        {
            effect.def = def; effect.frameCount = frame;
            auto &target = stage->buffers.effects[handle / effectStride];
            target.effect = effect; target.atomics.status = status;
        }
        const int defCount = def->elemDefCountLooping + def->elemDefCountOneShot + def->elemDefCountEmission;
        for (int group = 0; group < 3; ++group)
        {
            unsigned short elemHandle = effect.firstElemHandle[group], previous = 0xFFFF;
            while (elemHandle != 0xFFFF)
            {
                const int index = SP_NativeHandleIndex(elemHandle, fx_elemLimit, sizeof(FxElemContainer) / 4);
                if (elemsSeen[index]) Com_Error(ERR_DROP, "Client effects checkpoint rejected particle cycle/alias");
                elemsSeen[index] = true; ++elems;
                FxElemContainer value{}; PhysSavedBodyState body{}; int hasPhysics = 0;
                if (!c.reader)
                {
                    value = FX_ElemFromHandle(system, elemHandle)->item;
                    if (value.elem.defIndex >= defCount) Com_Error(ERR_DROP, "Client effects checkpoint rejected particle definition");
                    const FxElemDef &elemDef = def->elemDefsEA[value.elem.defIndex];
                    if (elemDef.elemType == 7 && (elemDef.flags & 0x8000000))
                    {
                        hasPhysics = value.elem.physObjId != 0;
                        if (hasPhysics)
                        {
                            Phys_CaptureBodyState(value.elem.physObjId, &body);
                            if (verifyPhysics)
                            {
                                const auto &saved = verifyPhysics->physical[index];
                                if (!saved.present || saved.effectHandle != handle
                                    || !Phys_VerifyAppliedBodyState(value.elem.physObjId, &saved.body))
                                    Com_Error(ERR_DROP, "Client effects verification lost its exact physical transform");
                                // Compare the original logical pose encoding only
                                // after exact live matrix/COM/motion verification.
                                body = saved.body;
                            }
                        }
                        memset(value.elem.origin, 0, sizeof(value.elem.origin)); // Never persist a runtime Phys ID.
                    }
                }
                static_assert(sizeof(FxElemContainer) == 48);
                c.Field(value); c.Field(hasPhysics);
                if (value.elem.defIndex >= defCount || value.shared.prevElemHandleInEffect != previous || (unsigned)hasPhysics > 1)
                    Com_Error(ERR_DROP, "Client effects checkpoint rejected particle links/definition");
                const FxElemDef &elemDef = def->elemDefsEA[value.elem.defIndex];
                if (elemDef.elemType == 7 && (elemDef.flags & 0x8000000))
                {
                    if (value.elem.origin[0] || value.elem.origin[1] || value.elem.origin[2]) Com_Error(ERR_DROP, "Client effects checkpoint contains a physics ID");
                }
                else if (hasPhysics) Com_Error(ERR_DROP, "Client effects checkpoint physics owner mismatch");
                if (hasPhysics)
                {
                    c.Field(body); ++physics;
                    if (!Phys_IsSavedBodyStateValid(&body)) Com_Error(ERR_DROP, "Client effects checkpoint invalid physical particle");
                    if (stage)
                    {
                        stage->physical[index].present = true;
                        stage->physical[index].effectHandle = handle;
                        stage->physical[index].body = body;
                    }
                }
                if (stage) stage->buffers.elems[index].item = value;
                previous = elemHandle; elemHandle = value.shared.nextElemHandleInEffect;
            }
        }
        for (unsigned short trailHandle = effect.firstTrailHandle; trailHandle != 0xFFFF;)
        {
            const int index = SP_NativeHandleIndex(trailHandle, 128, sizeof(FxTrail) / 4);
            if (trailsSeen[index]) Com_Error(ERR_DROP, "Client effects checkpoint rejected trail cycle/alias");
            trailsSeen[index] = true; ++trails;
            FxTrail trail{}; if (!c.reader) trail = system->trails[index].item;
            c.Field(trail);
            if (stage) stage->buffers.trails[index].item = trail;
            if ((unsigned char)trail.defIndex >= defCount) Com_Error(ERR_DROP, "Client effects checkpoint rejected trail definition");
            unsigned short tail = 0xFFFF;
            for (unsigned short h = trail.firstElemHandle; h != 0xFFFF;)
            {
                const int slot = SP_NativeHandleIndex(h, 2048, sizeof(FxTrailElem) / 4);
                if (trailElemsSeen[slot]) Com_Error(ERR_DROP, "Client effects checkpoint rejected trail element cycle/alias");
                trailElemsSeen[slot] = true; ++trailElems;
                FxTrailElem value{}; if (!c.reader) value = system->trailElems[slot].item;
                c.Field(value); tail = h; h = value.nextTrailElemHandle;
                if (stage) stage->buffers.trailElems[slot].item = value;
            }
            if (tail != trail.lastElemHandle) Com_Error(ERR_DROP, "Client effects checkpoint rejected trail tail");
            trailHandle = trail.nextTrailHandle;
        }
    }
    // Persist free-list order as indices, not stale union payloads.
    const auto pool = [&c](auto *values, auto *target, int limit, const bool *seen, int active, unsigned head) {
        int firstFree = head; c.Field(firstFree);
        int links[FX_ELEM_POOL_MAX]{};
        for (int i = 0; i < limit; ++i)
            if (!seen[i]) { if (!c.reader) links[i] = values[i].nextFree; c.Field(links[i]); }
        bool visited[FX_ELEM_POOL_MAX]{}; int count = 0;
        for (int i = firstFree; i != -1; i = links[i])
        {
            if (i < 0 || i >= limit || seen[i] || visited[i]) Com_Error(ERR_DROP, "Client effects checkpoint rejected free pool chain");
            visited[i] = true; ++count;
        }
        if (count + active != limit) Com_Error(ERR_DROP, "Client effects checkpoint incomplete pool ownership");
        if (target) for (int i = 0; i < limit; ++i) if (!seen[i]) target[i].nextFree = links[i];
        return static_cast<unsigned>(firstFree);
    };
    const auto freeElem = pool(system->elems, stage ? stage->buffers.elems : nullptr, fx_elemLimit, elemsSeen, elems, system->shared->firstFreeElem);
    const auto freeTrail = pool(system->trails, stage ? stage->buffers.trails : nullptr, 128, trailsSeen, trails, system->shared->firstFreeTrail);
    const auto freeTrailElem = pool(system->trailElems, stage ? stage->buffers.trailElems : nullptr, 2048, trailElemsSeen, trailElems, system->shared->firstFreeTrailElem);
    if (stage)
    {
        stage->container.shared.firstFreeElem = freeElem;
        stage->container.shared.firstFreeTrail = freeTrail;
        stage->container.shared.firstFreeTrailElem = freeTrailElem;
        stage->container.shared.activeElemCount = elems;
        stage->container.shared.activeTrailCount = trails;
        stage->container.shared.activeTrailElemCount = trailElems;
        stage->effects = last - first; stage->particles = elems;
        stage->trails = trails; stage->trailElements = trailElems; stage->physicalParticles = physics;
    }
    if (c.Int(elems) != elems || c.Int(trails) != trails || c.Int(trailElems) != trailElems)
        Com_Error(ERR_DROP, "Client effects checkpoint particle accounting mismatch");
    if (schema == 0x32505846)
    {
        SPFxCheckpointControls controls{};
        if (!c.reader)
        {
            controls.cameras[0] = system->camera; controls.cameras[1] = system->cameraPrev;
            controls.cameras[2] = system->extraCamera; controls.cameras[3] = system->extraCameraPre;
            memcpy(controls.restartList, system->restartList, sizeof(controls.restartList));
            controls.priority = system->priorityInfo;
            controls.needsCollection = system->needsGarbageCollection; controls.staleAttachments = system->hasStaleAttachedFx;
            controls.spotlightBolt = system->activeSpotLightBoltDobj;
            controls.spotlightEffect = system->shared->activeSpotLightEffectHandle;
            controls.spotlightElement = system->shared->activeSpotLightElemHandle;
            controls.spotlightEffects = system->shared->activeSpotLightEffectCount;
            controls.spotlightElements = system->shared->activeSpotLightElemCount;
        }
        for (auto &camera : controls.cameras)
        {
            c.Field(camera.origin); unsigned valid = camera.isValid; c.Field(valid); camera.isValid = valid;
            c.Field(camera.frustum); c.Field(camera.axis); c.Field(camera.frustumPlaneCount);
            if (valid > 1 || camera.frustumPlaneCount > 6) Com_Error(ERR_DROP, "Client effects checkpoint invalid camera");
        }
        c.Field(controls.restartList); c.Field(controls.priority.warningHigh); c.Field(controls.priority.readIndex);
        c.Field(controls.needsCollection); c.Field(controls.staleAttachments);
        c.Field(controls.spotlightBolt); c.Field(controls.spotlightEffect); c.Field(controls.spotlightElement);
        c.Field(controls.spotlightEffects); c.Field(controls.spotlightElements);
        if ((unsigned)controls.priority.readIndex > 1 || controls.spotlightEffects > 1 || controls.spotlightElements > 1)
            Com_Error(ERR_DROP, "Client effects checkpoint invalid priority/spotlight controls");
        if (stage) { stage->controls = controls; stage->hasControls = true; }
    }
    Com_Printf(15, "Client effects checkpoint: %s %u effects / %i handles / %i particles / %i trails / %i trail elements / %i physical particles; no native pointers or physics IDs\n",
        c.reader ? "decoded" : "captured", last - first, used, elems, trails, trailElems, physics);
}

#include "g_sp_fx_physics_checkpoint.inl"

static void SP_PublishClientEffects(SPFxCheckpointStage &stage)
{
    if (!stage.hasControls)
        Com_Error(ERR_DROP, "Client effects publication requires supplemental controls");
    SP_PreflightClientEffectsPhysics(stage);
    auto *container = FX_GetSystem(0);
    FxSystem *system = &container->system;
    if (!system->isInitialized || system->shared->iteratorCount)
        Com_Error(ERR_DROP, "Client effects publication lost joined native owners");
    for (const auto &owner : stage.buffers.effects)
        if (owner.effect.def && (owner.atomics.status & 0x60000000))
            Com_Error(ERR_DROP, "Client effects publication rejected a transient effect lock");
    // Retire native particle owners before replacing allocator state. Hunk pool
    // addresses and the separately owned marks system remain live in this probe.
    FX_KillAllEffects(0);
    if (system->shared->activeElemCount || system->shared->activeTrailCount || system->shared->activeTrailElemCount)
        Com_Error(ERR_DROP, "Client effects publication failed canonical particle retirement");
    memcpy(FX_GetSystemBuffers(0), &stage.buffers, sizeof(stage.buffers));
    container->shared = stage.container.shared;
    FX_LinkSystemBuffers(system, FX_GetSystemBuffers(0));
    system->shared = &container->shared;
    system->msecNow = stage.container.system.msecNow;
    system->msecDraw = stage.container.system.msecDraw;
    system->frameCount = stage.container.system.frameCount;
    system->camera = stage.controls.cameras[0]; system->cameraPrev = stage.controls.cameras[1];
    system->extraCamera = stage.controls.cameras[2]; system->extraCameraPre = stage.controls.cameras[3];
    memcpy(system->restartList, stage.controls.restartList, sizeof(system->restartList));
    system->priorityInfo = stage.controls.priority;
    system->needsGarbageCollection = stage.controls.needsCollection;
    system->hasStaleAttachedFx = stage.controls.staleAttachments;
    system->activeSpotLightBoltDobj = stage.controls.spotlightBolt;
    system->shared->activeSpotLightEffectHandle = stage.controls.spotlightEffect;
    system->shared->activeSpotLightElemHandle = stage.controls.spotlightElement;
    system->shared->activeSpotLightEffectCount = stage.controls.spotlightEffects;
    system->shared->activeSpotLightElemCount = stage.controls.spotlightElements;
    system->sprite = {}; system->gfxCloudCount = 0;
    system->visStateBufferRead = system->visState; system->visStateBufferWrite = system->visState + 1;
    SP_PublishClientEffectsPhysics(stage, system);
    int rebound = 0;
    for (auto &node : system->uniqueHandleDb->nodes)
        if (node.effect != 0xFFFF)
        {
            if (UniqueHandleToEffect(system, node.handle) != FX_EffectFromHandle(system, node.effect))
                Com_Error(ERR_DROP, "Client effects publication lost script handle identity");
            ++rebound;
        }
    Com_Printf(15, "Client effects publication: REBOUND %i script handles, %i effects / %i particles; canonical old owners retired, live pools restored\n",
        rebound, stage.effects, stage.particles);
}

static void SP_VerifyLiveEffectsCheckpoint()
{
    static unsigned char bytes[0x140000], decodedBytes[0x140000], checkBytes[0x140000];
    static MemoryFile writer, reader, decoded, check;
    static SPFxCheckpointStage stage;
    memset(&stage, 0, sizeof(stage));
    MemFile_InitForWriting(&writer, sizeof(bytes), bytes, true, true);
    SPNativeCheckpointCodec capture{nullptr, &writer}; SP_ClientEffectsCodec(capture);
    MemFile_StartSegment(&writer, -1);
    MemFile_InitForReading(&reader, writer.bytesUsed, bytes, true);
    MemFile_InitForWriting(&decoded, sizeof(decodedBytes), decodedBytes, true, true);
    SPNativeCheckpointCodec decode{&reader, &decoded}; SP_ClientEffectsCodec(decode, &stage);
    MemFile_MoveToSegment(&reader, -1); MemFile_StartSegment(&decoded, -1);
    if (writer.bytesUsed != decoded.bytesUsed || memcmp(bytes, decodedBytes, writer.bytesUsed))
        Com_Error(ERR_DROP, "Live FX checkpoint staged decode differs before publication");
    SP_PublishClientEffects(stage);
    MemFile_InitForWriting(&check, sizeof(checkBytes), checkBytes, true, true);
    SPNativeCheckpointCodec verify{nullptr, &check}; SP_ClientEffectsCodec(verify, nullptr, &stage);
    MemFile_StartSegment(&check, -1);
    if (writer.bytesUsed != check.bytesUsed || memcmp(bytes, checkBytes, writer.bytesUsed))
        Com_Error(ERR_DROP, "Live FX checkpoint new owners differ from saved state");
    Com_Printf(15, "Client effects publication: LIVE RESERIALIZATION IDENTICAL, continuing real frames\n");
}

#include "g_sp_audio_mixer_checkpoint.inl"
#include "g_sp_audio_owners_checkpoint.inl"
#include "g_sp_audio_occlusion_checkpoint.inl"

struct SPAudioCheckpointStage
{
    SPAudioMixerCheckpoint mixer;
    SPAudioOwnersCheckpoint owners;
    SPAudioOcclusionCheckpoint occlusion;
    int schema;
    bool hasMixer;
    int time, looptime, pausetime;
    unsigned counter, used;
    snd_playback playbacks[148];
    snd_voice_t voices[74];
    int slots[74];
    __int64 cursors[74];
    bool active[74];
};

// SNDL_GetPlaybackTime returns a signed clock difference. A voice starting
// after the pause clock can legitimately have a negative elapsed value; keep
// that value verbatim, as with future startTime during the clock rebase.
static bool SP_ValidAudioPlayback(const snd_playback &playback)
{
    return std::isfinite(playback.attenuation) && playback.lengthMs >= 0;
}

static void SP_ClientAudioCodec(SPNativeCheckpointCodec &c, SPAudioCheckpointStage *stage = nullptr, const SPAudioCheckpointStage *source = nullptr, int outputSchema = 0x34504453)
{
    const int schema = c.Int(source ? source->schema : outputSchema); // SDP4; SDP1/2/3 remain readable
    if (schema < 0x31504453 || schema > 0x34504453 || (schema & 0xFFFFFF) != 0x504453) Com_Error(ERR_DROP, "Client audio checkpoint schema mismatch");
    if (!c.reader && (SND_CommandPeek() || SND_NotifyPeek()))
        Com_Error(ERR_DROP, "Client audio checkpoint lost its joined command/notification boundary");
    if (stage) { stage->schema = schema; stage->hasMixer = schema != 0x31504453; }
    if (schema != 0x31504453)
    {
        SPAudioMixerCheckpoint mixer{};
        if (!c.reader)
        {
            if (source) mixer = source->mixer;
            else SP_ReadLiveAudioMixer(mixer);
        }
        SP_ClientAudioMixerCodec(c, mixer);
        if (stage) stage->mixer = mixer;
    }
    if (schema >= 0x33504453)
    {
        SPAudioOwnersCheckpoint owners{};
        if (!c.reader)
        {
            if (source) owners = source->owners;
            else SP_ReadLiveAudioOwners(owners);
        }
        SP_ClientAudioOwnersCodec(c, owners);
        if (stage) stage->owners = owners;
    }
    if (schema == 0x34504453)
    {
        SPAudioOcclusionCheckpoint occlusion{};
        if (!c.reader)
        {
            if (source) occlusion = source->occlusion;
            else SP_ReadLiveAudioOcclusion(occlusion);
        }
        SP_ClientAudioOcclusionCodec(c, occlusion);
        if (stage) stage->occlusion = occlusion;
    }
    const int time = c.Int(source ? source->time : g_snd.time);
    const int looptime = c.Int(source ? source->looptime : g_snd.looptime);
    const int pausetime = c.Int(source ? source->pausetime : g_snd.pausetime);
    unsigned counter = source ? source->counter : g_snd.playbackIdCounter; c.Field(counter);
    snd_playback playbacks[148]{};
    if (!c.reader) memcpy(playbacks, source ? source->playbacks : g_snd.playbacks, sizeof(playbacks));
    static_assert(sizeof(snd_playback) == 16);
    c.Field(playbacks);
    int used = 0;
    for (int i = 0; i < 148; ++i)
    {
        if (playbacks[i].id == -1) continue;
        if (!SP_ValidAudioPlayback(playbacks[i]))
        {
            if (!c.reader && !source)
                for (int v = 0; v < 74; ++v)
                    if (g_snd.voiceAliasHash[v] && g_snd.voice[v].playback == &g_snd.playbacks[i])
                    {
                        const auto &voice = g_snd.voice[v];
                        const auto *asset = voice.alias ? voice.alias->soundFile : nullptr;
                        const auto *ram = asset && asset->type == 1 && asset->u.loadSnd ? &asset->u.loadSnd->sound : nullptr;
                        Com_Printf(15, "Client audio checkpoint rejected owner: voice %i alias %s type %i duration %i fileDuration %i delay %i start %i loading %i frames %u rate %u\n",
                            v, voice.alias ? voice.alias->name : "<none>", asset ? asset->type : -1,
                            voice.totalMsec, voice.soundFileInfo.totalMsec, voice.startDelay, voice.startTime,
                            voice.soundFileInfo.loadingState, ram ? ram->frame_count : 0, ram ? ram->frame_rate : 0);
                    }
            Com_Error(ERR_DROP, "Client audio checkpoint invalid playback slot %i id %i attenuation %g length %i elapsed %i clock %i pause %i",
                i, playbacks[i].id, playbacks[i].attenuation, playbacks[i].lengthMs, playbacks[i].playedMs, time, pausetime);
        }
        if (!c.reader && !source && playbacks[i].playedMs < 0)
            Com_Printf(15, "Client audio checkpoint: signed elapsed retained slot %i id %i elapsed %i length %i clock %i pause %i\n",
                i, playbacks[i].id, playbacks[i].playedMs, playbacks[i].lengthMs, time, pausetime);
        for (int j = 0; j < i; ++j)
            if (playbacks[j].id == playbacks[i].id) Com_Error(ERR_DROP, "Client audio checkpoint duplicate playback ID");
        ++used;
    }
    if (c.Int(c.reader ? used : source ? source->used : g_snd.playbacksInUse) != used) Com_Error(ERR_DROP, "Client audio checkpoint playback accounting mismatch");
    if (stage)
    {
        stage->time = time; stage->looptime = looptime; stage->pausetime = pausetime;
        stage->counter = counter; stage->used = used; memcpy(stage->playbacks, playbacks, sizeof(playbacks));
    }
    int voices = 0, streams = 0;
    for (int i = 0; i < 74; ++i)
    {
        int active = source ? source->active[i] : g_snd.voiceAliasHash[i] != 0; c.Field(active);
        if ((unsigned)active > 1) Com_Error(ERR_DROP, "Client audio checkpoint invalid voice occupancy");
        if (!active) continue;
        ++voices; streams += SND_IsStream(i);
        snd_voice_t voice{}; if (!c.reader) memcpy(&voice, source ? &source->voices[i] : &g_snd.voice[i], sizeof(voice));
        if (!c.reader && voice.lengthNotifyInfo.count) Com_Error(ERR_DROP, "Client audio checkpoint requires delivered length notifications");
        const char *name = c.Name(c.reader ? nullptr : voice.alias->name);
        const auto *list = SND_FindAlias(name);
        int variant = -1;
        if (!c.reader && list)
            for (int j = 0; j < list->count; ++j) if (&list->head[j] == voice.alias) variant = j;
        c.Field(variant);
        if (!list || variant < 0 || variant >= list->count) Com_Error(ERR_DROP, "Client audio checkpoint lost selected alias");
        const snd_alias_t *alias = &list->head[variant];
        const SoundFile *sound = alias->soundFile;
        if (!sound) Com_Error(ERR_DROP, "Client audio checkpoint missing sound asset");
        const char *filename = c.Name(sound->type == 1 ? sound->u.loadSnd->name : sound->u.streamSnd->filename);
        const char *expected = sound->type == 1 ? sound->u.loadSnd->name : sound->u.streamSnd->filename;
        if (strcmp(filename, expected)) Com_Error(ERR_DROP, "Client audio checkpoint selected asset changed");
        int slot = -1;
        if (source) slot = source->slots[i];
        else if (!c.reader && voice.playback)
        {
            for (int j = 0; j < 148; ++j) if (&g_snd.playbacks[j] == voice.playback) slot = j;
            if (slot == -1) Com_Error(ERR_DROP, "Client audio checkpoint unknown playback owner");
        }
        c.Field(slot);
#define SND_FIELD(member) c.Field(voice.member)
        SND_FIELD(soundFileInfo); SND_FIELD(sndEnt); SND_FIELD(entity_update); SND_FIELD(group);
        SND_FIELD(startDelay); SND_FIELD(startTime); SND_FIELD(looptime); SND_FIELD(totalMsec);
        SND_FIELD(playbackId); SND_FIELD(firstPlaybackId); SND_FIELD(offset); SND_FIELD(position);
        SND_FIELD(velocity); SND_FIELD(orientation); SND_FIELD(direction); SND_FIELD(fluxVelocity);
        SND_FIELD(baseDistance); SND_FIELD(distanceAttenuation); SND_FIELD(reverbAttenuation); SND_FIELD(cylinderAttenuation);
        SND_FIELD(volModSeed); SND_FIELD(volModStart); SND_FIELD(pitchModSeed); SND_FIELD(globalPriority);
        SND_FIELD(doppler); SND_FIELD(fade); SND_FIELD(script_fade); SND_FIELD(script_pitch); SND_FIELD(losOcclusion);
        if (schema == 0x34504453) voice.losHitCache = 0;
        SND_FIELD(losHitCache);
        if (schema == 0x34504453 && voice.losHitCache) Com_Error(ERR_DROP, "Occlusion checkpoint contains stale voice collision hint");
        SND_FIELD(closestListenerIndex); SND_FIELD(voiceStartTime);
        SND_FIELD(dryLevel); SND_FIELD(wetLevel); SND_FIELD(futzBlend); SND_FIELD(pan); SND_FIELD(panGoal);
        SND_FIELD(paused);
        // ResetVoiceInfo fills the entire voice with FF. This unused legacy
        // field is never initialized by SetVoiceStartInfo or consumed by the
        // mixer. Preserve its byte sentinel without evaluating an invalid bool.
        unsigned char unusedTimescale = 0;
        if (!c.reader) memcpy(&unusedTimescale, &voice.timescale, 1);
        c.Field(unusedTimescale);
        if (unusedTimescale != 0 && unusedTimescale != 1 && unusedTimescale != 255)
            Com_Error(ERR_DROP, "Client audio checkpoint invalid unused timescale sentinel");
        if (c.reader) memcpy(&voice.timescale, &unusedTimescale, 1);
        SND_FIELD(positionUpdated); SND_FIELD(pitchShift); SND_FIELD(played);
#undef SND_FIELD
        __int64 cursor = c.reader ? 0 : source ? source->cursors[i] : SD_BO1SamplesPlayed(i); c.Field(cursor);
        if (slot < -1 || slot >= 148 || (slot >= 0 && playbacks[slot].id != voice.playbackId) || cursor < -1)
            Com_Error(ERR_DROP, "Client audio checkpoint rejected playback/cursor binding");
        if (stage)
        {
            voice.alias = alias; voice.playback = nullptr;
            memcpy(&stage->voices[i], &voice, sizeof(voice));
            stage->slots[i] = slot; stage->cursors[i] = cursor; stage->active[i] = true;
        }
    }
    Com_Printf(15, "Client audio checkpoint: %s %i voices (%i streams), %i playback IDs with selected aliases and sample cursors; driver restore pending\n",
        c.reader ? "decoded" : "captured", voices, streams, used);
}

#include "g_sp_audio_publication.inl"

static void SP_VerifyLiveAudioCheckpoint()
{
    if (!SP_QuiesceClientAudioCheckpoint() || !SP_FreezeAudioCheckpoint())
        Com_Error(ERR_DROP, "Live audio checkpoint could not join/freeze the actual mixer");
    static unsigned char bytes[0x40000], decodedBytes[0x40000], checkBytes[0x40000];
    static MemoryFile writer, reader, decoded, check;
    static SPAudioCheckpointStage stage;
    memset(&stage, 0, sizeof(stage));
    MemFile_InitForWriting(&writer, sizeof(bytes), bytes, true, true);
    SPNativeCheckpointCodec capture{nullptr, &writer}; SP_ClientAudioCodec(capture);
    MemFile_StartSegment(&writer, -1);
    MemFile_InitForReading(&reader, writer.bytesUsed, bytes, true);
    MemFile_InitForWriting(&decoded, sizeof(decodedBytes), decodedBytes, true, true);
    SPNativeCheckpointCodec decode{&reader, &decoded}; SP_ClientAudioCodec(decode, &stage);
    MemFile_MoveToSegment(&reader, -1); MemFile_StartSegment(&decoded, -1);
    if (writer.bytesUsed != decoded.bytesUsed || memcmp(bytes, decodedBytes, writer.bytesUsed))
    {
        SD_EndCheckpoint();
        Com_Error(ERR_DROP, "Live audio checkpoint staged decode differs");
    }
    SP_PublishAudioOwners(stage.owners);
    SP_PublishAudioOcclusion(stage.occlusion);
    int rebuilt = 0, nonzero = 0, retained = 0, streamRebuilt = 0, streamNonzero = 0;
    for (int i = 0; i < 74; ++i)
    {
        if (!stage.active[i]) continue;
        const bool stream = i < SND_MAX_STREAM_VOICES;
        if (!(stream ? SD_CanRestoreStreamVoice(i, stage.cursors[i]) : SD_CanRestoreResidentVoice(i, stage.cursors[i]))) { ++retained; continue; }
        // Rebind the decoded logical voice to its fixed playback pool slot and
        // resolved asset; recreate its actual driver source/sample borrower.
        memcpy(&g_snd.voice[i], &stage.voices[i], sizeof(snd_voice_t));
        const int slot = stage.slots[i];
        g_snd.voice[i].playback = slot >= 0 ? &g_snd.playbacks[slot] : nullptr;
        if ((slot >= 0 && SND_FindPlayback(stage.voices[i].playbackId) != &g_snd.playbacks[slot])
            || !(stream ? SD_RestoreStreamVoice(i, stage.cursors[i]) : SD_RestoreResidentVoice(i, stage.cursors[i])))
        {
            SD_EndCheckpoint();
            Com_Error(ERR_DROP, "Live audio checkpoint could not bind/recreate voice %i", i);
        }
        if (stream) { ++streamRebuilt; streamNonzero += stage.cursors[i] > 0; }
        else { ++rebuilt; nonzero += stage.cursors[i] > 0; }
    }
    MemFile_InitForWriting(&check, sizeof(checkBytes), checkBytes, true, true);
    SPNativeCheckpointCodec verify{nullptr, &check}; SP_ClientAudioCodec(verify);
    MemFile_StartSegment(&check, -1);
    const bool identical = writer.bytesUsed == check.bytesUsed && !memcmp(bytes, checkBytes, writer.bytesUsed);
    const bool restarted = SND_EndOcclusionCheckpoint() && SD_EndCheckpoint();
    if (!(rebuilt + streamRebuilt) || !(nonzero + streamNonzero) || !identical || !restarted)
        Com_Error(ERR_DROP, "Live audio checkpoint failed resident/cursor/readback/mixer restart checks (%i/%i/%i/%i)", rebuilt, nonzero, identical, restarted);
    Com_Printf(15, "Client audio publication: REBOUND %i real resident sources (%i nonzero sample cursors), playback IDs retained, LIVE RESERIALIZATION IDENTICAL; %i existing stream/unsupported voices retained, NOT restored\n",
        rebuilt, nonzero, retained);
    Com_Printf(15, "Client stream publication: REBOUND %i real streamed sources (%i nonzero sample cursors), LIVE RESERIALIZATION IDENTICAL\n", streamRebuilt, streamNonzero);
    // Original live cgame is still valid here. Exercise a real sound update and
    // wait for its actual worker batch, proving the gate did not lose a wakeup.
    SPAudioOcclusionCheckpoint after{};
    for (int attempt = 0; attempt < 32; ++attempt)
    {
        if (!SP_QuiesceClientAudioCheckpoint() || !SP_FreezeAudioCheckpoint())
            Com_Error(ERR_DROP, "Occlusion live probe could not rejoin next actual batch");
        SP_ReadLiveAudioOcclusion(after);
        if (after.sequence != stage.occlusion.sequence) break;
        if (!SND_EndOcclusionCheckpoint() || !SD_EndCheckpoint())
            Com_Error(ERR_DROP, "Occlusion live probe failed deferred-update release");
    }
    if (after.sequence == stage.occlusion.sequence || after.sequence != after.completed)
        Com_Error(ERR_DROP, "Occlusion live probe did not complete a new real worker batch");
    Com_Printf(15, "Client audio occlusion: LIVE WORKER ADVANCED sequence %u -> %u completed %u, real collision traces\n", stage.occlusion.sequence, after.sequence, after.completed);
    if (!SND_EndOcclusionCheckpoint() || !SD_EndCheckpoint()) Com_Error(ERR_DROP, "Occlusion live probe failed worker/mixer release");
}

static void SP_WriteClientNativeOwners(MemoryFile *file)
{
    SPNativeCheckpointCodec codec{nullptr, file};
    SP_ClientEffectsCodec(codec); SP_ClientAudioCodec(codec);
}

static SPFxCheckpointStage s_decodedClientEffects;
static unsigned char s_decodedClientEffectBytes[0x140000];
static int s_decodedClientEffectByteCount;

static void SP_VerifyClientNativeOwners(MemoryFile *reader)
{
    const unsigned char *original = MemFile_GetSegmentAddess(reader, 3);
    MemFile_MoveToSegment(reader, 3);
    static unsigned char bytes[0x140000]; static MemoryFile writer;
    MemFile_InitForWriting(&writer, sizeof(bytes), bytes, true, true);
    SPNativeCheckpointCodec codec{reader, &writer};
    SP_ClientEffectsCodec(codec); SP_ClientAudioCodec(codec);
    MemFile_StartSegment(&writer, -1);
    int length; memcpy(&length, original, 4);
    if (length != writer.bytesUsed || memcmp(original, bytes, length)) Com_Error(ERR_DROP, "Client native owner checkpoint reserialization differs");
    Com_Printf(15, "Client native owners: FX/audio RESERIALIZATION IDENTICAL (%i bytes), decode only\n", length);
    s_decodedClientEffectByteCount = 0;
    s_clientAudioPrepared = s_clientAudioRetired = false;
    if (G_SP_CheckpointOption("bo1_client_fx_publish") || G_SP_CheckpointOption("bo1_client_audio_publish"))
    {
        // Validate and retain an isolated FX record before retiring any old
        // client consumers. No pointers from the disk graph are published.
        memset(&s_decodedClientEffects, 0, sizeof(s_decodedClientEffects));
        MemFile_MoveToSegment(reader, 3);
        MemFile_InitForWriting(&writer, sizeof(s_decodedClientEffectBytes), s_decodedClientEffectBytes, true, true);
        SPNativeCheckpointCodec fx{reader, &writer};
        SP_ClientEffectsCodec(fx, &s_decodedClientEffects);
        MemFile_StartSegment(&writer, -1);
        if (G_SP_CheckpointOption("bo1_client_fx_publish"))
        {
            if (!s_decodedClientEffects.hasControls) Com_Error(ERR_DROP, "Fresh FX probe requires FXP2 controls");
            SP_PreflightClientEffectsPhysics(s_decodedClientEffects);
        }
        s_decodedClientEffectByteCount = writer.bytesUsed;
        if (G_SP_CheckpointOption("bo1_client_audio_publish"))
        {
            memset(&s_decodedClientAudio, 0, sizeof(s_decodedClientAudio));
            MemFile_InitForWriting(&writer, sizeof(bytes), bytes, true, true);
            SPNativeCheckpointCodec audio{reader, &writer}; SP_ClientAudioCodec(audio, &s_decodedClientAudio);
            MemFile_StartSegment(&writer, -1);
            SP_PreflightFreshAudio();
        }
    }
}

static void SP_VerifyFreshClientEffectsPublication(bool retain = false)
{
    if (!s_decodedClientEffectByteCount)
        Com_Error(ERR_DROP, "Fresh FX publication has no validated staged owner graph");
    // Old CG_Shutdown and VM teardown already retired their handle consumers.
    // Build real fresh FX owners, then validate before any restored VM frames.
    FX_InitSystem(0);
    SP_PublishClientEffects(s_decodedClientEffects);
    static unsigned char bytes[0x140000]; static MemoryFile writer;
    MemFile_InitForWriting(&writer, sizeof(bytes), bytes, true, true);
    SPNativeCheckpointCodec check{nullptr, &writer}; SP_ClientEffectsCodec(check, nullptr, &s_decodedClientEffects);
    MemFile_StartSegment(&writer, -1);
    if (writer.bytesUsed != s_decodedClientEffectByteCount || memcmp(bytes, s_decodedClientEffectBytes, writer.bytesUsed))
        Com_Error(ERR_DROP, "Fresh FX published owners differ from the durable checkpoint");
    Com_Printf(15, "Client effects publication: FRESH PROCESS LIVE RESERIALIZATION IDENTICAL, %i effects / %i particles; NO CLIENT FRAMES\n",
        s_decodedClientEffects.effects, s_decodedClientEffects.particles);
    if (retain)
    {
        s_decodedClientEffectByteCount = 0;
        Com_Printf(15, "Client effects publication: owners retained for bounded saved CLIENT frames\n");
        return;
    }
    // This bounded test does not reinitialize the rest of cgame. Retire these
    // actual new owners explicitly before normal global shutdown of the probe.
    FX_KillAllEffects(0);
    const auto *shared = FX_GetSystem(0)->system.shared;
    if (shared->activeElemCount || shared->activeTrailCount || shared->activeTrailElemCount)
        Com_Error(ERR_DROP, "Fresh FX probe failed real particle retirement");
    FX_ShutdownSystem(0);
    s_decodedClientEffectByteCount = 0;
    Com_Printf(15, "Client effects publication: fresh probe owners canonically retired, normal quit\n");
}
